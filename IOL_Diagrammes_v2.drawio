        <mxCell id="arch_note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#1f2937;fontSize=10;align=left;verticalAlign=top;spacing=7;" value="&lt;b&gt;Règle structurante&lt;/b&gt;&lt;br&gt;Hop et Spark ne se connectent jamais à la source métier. Ils consomment uniquement les artefacts transportés par Kafka ou RustFS. Le choix LOCAL/SPARK est interne et automatique. Les objets RustFS sont supprimés après succès durable; en échec, une rétention de secours de 72 h permet le diagnostic puis la purge." vertex="1">
          <mxGeometry height="150" width="720" x="1530" y="1050" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
