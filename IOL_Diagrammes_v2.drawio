        <mxCell id="k_note_data" parent="1" value="&lt;b&gt;Données normales&lt;/b&gt;&lt;br&gt;JDBC/API/PUSH utilisent des lots JSON; un fichier utilise des chunks de son format original. Aucune conversion interne en CSV. La commande reste le dernier événement." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#1f2937;fontSize=10;align=left;verticalAlign=top;spacing=7;" vertex="1">
