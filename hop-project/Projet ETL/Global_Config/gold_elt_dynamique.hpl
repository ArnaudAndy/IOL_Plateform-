    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Execute SQL script</send_true_to>
    <send_false_to>Log Gold skipped</send_false_to>
    <compare>
      <condition>
        <conditions/>
        <function>=</function>
        <leftvalue>gold_enabled</leftvalue>
        <negated>N</negated>
        <operator>-</operator>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>true</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>160</yloc>
    </GUI>
