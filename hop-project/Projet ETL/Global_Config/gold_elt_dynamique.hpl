    <modified_user>-</modified_user>
    <modified_date>2026/04/21 15:24:32.433</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>JSON input</from>
      <to>Gold enabled?</to>
