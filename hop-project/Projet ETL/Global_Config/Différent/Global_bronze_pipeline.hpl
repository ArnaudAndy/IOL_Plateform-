  <transform>
    <name>JavaScript</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// 1. Exécutable et chemin du script — depuis des VARIABLES Hop (plus jamais en dur)
var pythonExe  = getVariable("PYTHON_EXE", "python");
var scriptPath = getVariable("MOTEUR_PATH", "/opt/hop/scripts/moteur_universel.py");

// 2. Injecter la connexion cible DANS le bloc options
//    Pour que le Python n'ait plus localhost en dur.
//    On part de options_bloc (le source_config) et on y greffe target_connection.
var enrichedOptions;
try {
    var optObj = JSON.parse(options_bloc);   // options_bloc = source_config de la source

    // Bloc target_connection construit depuis les champs du flux
    optObj.target_connection = {
        "host":     target_host,
        "port":     target_port,
        "database": target_database,
        "username": target_user,
        "password": target_password
    };

    // Mode de chargement et borne incrémentale
    optObj.load_mode          = (typeof load_mode !== 'undefined' &amp;&amp; load_mode) ? load_mode : "append";
    if (typeof incremental_column !== 'undefined' &amp;&amp; incremental_column) {
        optObj.incremental_column = incremental_column;
        optObj.last_watermark     = (typeof last_run !== 'undefined') ? last_run : null;
    }

    enrichedOptions = JSON.stringify(optObj);
} catch(e) {
    enrichedOptions = "{}";
}

// 3. Encoder en Base64 (comme avant)
var optionsBase64 = "";
try {
    var bytes = new java.lang.String(enrichedOptions).getBytes("UTF-8");
    optionsBase64 = java.util.Base64.getEncoder().encodeToString(bytes);
} catch(e) {
    optionsBase64 = "e30=";  // {} vide
}

// 4. Construire la commande
//    protocol = source_name (CSV, POSTGRES...) ; uri = file_path ou uri de connexion
var cmd = pythonExe + ' "' + scriptPath + '" "' + protocol + '" "' 
          + uri + '" "' + target_table + '" "' + optionsBase64 + '"';

// 5. cmd part dans le champ Fields du transform JavaScript → utilisé par Execute a process</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>cmd</name>
        <rename>cmd</rename>
        <type>String</type>
        <length>-1</length>
