  <transform>
    <name>JavaScript</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var proto = protocol.toUpperCase();
var active_step = "";

if (proto == "CSV") {
    active_step = "STEP_CSV";
    setVariable("VAR_PATH", config.file_path, "r");
    setVariable("VAR_SEP", config.source_config.delimiter, "r");
} 
else if (proto == "JDBC") {
    active_step = "STEP_JDBC";
    setVariable("VAR_QUERY", config.query, "r");
    // Si tu as des variables de connexion dynamique
    setVariable("VAR_DB_URL", config.connection_url, "r");
} 
else if (proto == "REST") {
    active_step = "STEP_REST_PARSE";
    setVariable("VAR_URL", config.url, "r");
    setVariable("VAR_JSON_LOOP", config.json_loop_path, "r");
} 
else if (proto == "NOSQL") {
    active_step = "STEP_NOSQL"; // Le composant MongoDB Input
    setVariable("VAR_MONGO_COLL", config.collection, "r");
    setVariable("VAR_MONGO_QUERY", config.query, "r");
} 
else if (proto == "XML") {
    active_step = "STEP_XML";
    setVariable("VAR_PATH", config.file_path, "r");
    setVariable("VAR_XML_LOOP", config.loop_xpath, "r");
} 
else {
    // Sécurité si le protocole dans MongoDB est mal écrit
    throw "Protocole non supporté : " + proto;
}

// Variable cruciale pour l'étape Metadata Injection
setVariable("INJECT_TARGET_STEP", active_step, "r");
// Variable pour la table de destination Bronze
setVariable("VAR_TARGET", config.target_table, "r");</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>    </fields>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>256</yloc>
    </GUI>
