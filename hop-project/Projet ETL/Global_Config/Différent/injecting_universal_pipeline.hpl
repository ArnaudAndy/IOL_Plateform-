  <transform>
    <name>JavaScript</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// 1. Définir les chemins
var pythonExe = "python"; // Ou le chemin complet vers ton python.exe
var scriptPath = "C:\\Users\\ANDY\\Desktop\\ING5\\Stage\\Projet ETL\\moteur_universel.py";

// 2. Préparer les arguments
// On transforme l'objet options en chaîne JSON et on échappe les guillemets pour le Shell
var optionsJson = JSON.stringify(config.options).replace(/"/g, '\\"');

// 3. Construire la commande finale
// Format : python script.py PROTO URI TARGET OPTIONS
var fullCommand = pythonExe + ' "' + scriptPath + '" "' + protocol + '" "' + config.uri + '" "' + config.target_table + '" "' + optionsJson + '"';

// On envoie cette commande au transform "Execute Process"
setVariable("CMD_PYTHON", fullCommand, "r");</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>    </fields>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>256</yloc>
    </GUI>
  </transform>
  <transform>
