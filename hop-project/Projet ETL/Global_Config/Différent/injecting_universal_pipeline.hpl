        <name>protocol</name>
        <path>$.source_name</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>uri</name>
        <path>$.config.file_path</path>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
