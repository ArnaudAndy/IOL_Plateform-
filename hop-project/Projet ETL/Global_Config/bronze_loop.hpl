  <transform>
    <name>JavaScript</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// 1. Exécutable et chemin du script — depuis des VARIABLES Hop (plus jamais en dur)
var pythonExe  = getVariable("PYTHON_EXE", "python");
var pythonUtf8Option = "-X";
var pythonUtf8Value = "utf8";
var pythonFlag = "-u";
var scriptPath = getVariable("MOTEUR_PATH", "${PROJECT_HOME}/Projet ETL/moteur_universel.py");

// 2. Injecter la connexion cible DANS le bloc options
//    Pour que le Python n'ait plus localhost en dur.
//    On part de options_bloc (le source_config) et on y greffe target_connection.
var enrichedOptions;
try {
    var optObj = JSON.parse(options_bloc);   // options_bloc = source_config de la source

    // Bloc target_connection construit depuis les champs du flux.
    // Fail-fast si Hop n'a pas résolu une variable: on refuse d'envoyer ${...} au Python.
    var targetConnection = {
        "host":     target_host,
        "port":     target_port,
        "database": target_database,
        "username": target_user,
        "password": target_password
    };
    var requiredKeys = ["host", "port", "database", "username", "password"];
    for (var i = 0; i &lt; requiredKeys.length; i++) {
        var key = requiredKeys[i];
        var value = String(targetConnection[key]);
        if (value === null || value === "" || value.indexOf("${") >= 0) {
            throw "Variable Hop target_connection non résolue: " + key + "=" + value;
        }
    }
    optObj.target_connection = targetConnection;

    // Mode de chargement (COMBIEN). Jamais 'append' ici : 'append/replace' c'est le
    // write_mode (comment on écrit en Bronze), géré côté moteur_universel.py (défaut append).
    var _loadMode = (typeof load_mode !== 'undefined' &amp;&amp; load_mode &amp;&amp; load_mode.indexOf("${") &lt; 0)
                    ? String(load_mode).toUpperCase() : "FULL";
    optObj.load_mode = _loadMode;

    // Borne incrémentale : colonne + dernier watermark (résolu par api-core, par source).
    var _incCol = (typeof incremental_column !== 'undefined' &amp;&amp; incremental_column
                   &amp;&amp; incremental_column.indexOf("${") &lt; 0) ? incremental_column : "";
    if (_incCol !== "") {
        optObj.incremental_column = _incCol;
        var _wm = (typeof last_watermark !== 'undefined' &amp;&amp; last_watermark
                   &amp;&amp; last_watermark.indexOf("${") &lt; 0) ? last_watermark : null;
        optObj.last_watermark = _wm;
    }

    // Projection des colonnes brutes (fields) : sélection à l'extraction (PAS de renommage).
    // read_sources émet fields en chaîne JSON (ex: ["date_op","amount"]).
    if (typeof fields !== 'undefined' &amp;&amp; fields &amp;&amp; fields.indexOf("${") &lt; 0) {
        try { optObj.fields = JSON.parse(fields); } catch(e) { /* fields non-JSON: ignoré */ }
    }

    enrichedOptions = JSON.stringify(optObj);
} catch(e) {
    throw "Erreur construction options Bronze: " + e;
}

// 3. Encoder en Base64 (comme avant)
var optionsBase64 = "";
try {
    var bytes = new java.lang.String(enrichedOptions).getBytes("UTF-8");
    optionsBase64 = java.util.Base64.getEncoder().encodeToString(bytes);
} catch(e) {
    optionsBase64 = "e30=";  // {} vide
}

// 4. Construire la commande
//    protocol = source_name (CSV, POSTGRES...) ; uri = file_path ou uri de connexion
var cmd = pythonExe + ' -X utf8 -u "' + scriptPath + '" "' + protocol + '" "'
          + uri + '" "' + target_table + '" "' + optionsBase64 + '"';

// 5. cmd part dans le champ Fields du transform JavaScript → utilisé par Execute a process</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>cmd</name>
        <rename>cmd</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>pythonExe</name>
        <rename>pythonExe</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>pythonUtf8Option</name>
        <rename>pythonUtf8Option</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>pythonUtf8Value</name>
        <rename>pythonUtf8Value</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>pythonFlag</name>
        <rename>pythonFlag</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>scriptPath</name>
        <rename>scriptPath</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>optionsJson</name>
        <rename>optionsJson</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>optionsBase64</name>
        <rename>optionsBase64</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>256</yloc>
    </GUI>
  </transform>
