{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iol.local/schemas/data-sharing-contract.schema.json",
  "title": "IOL Data Sharing Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "version",
    "status",
    "providerOrganizationId",
    "consumerOrganizationId",
    "direction",
    "standard",
    "purposes",
    "dataClassification",
    "fieldPolicy",
    "retention",
    "transport",
    "delivery",
    "validity"
  ],
  "properties": {
    "contractId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": ["DRAFT", "ACTIVE", "SUSPENDED", "REVOKED", "EXPIRED"]
    },
    "providerOrganizationId": {
      "$ref": "#/$defs/organizationId"
    },
    "consumerOrganizationId": {
      "$ref": "#/$defs/organizationId"
    },
    "direction": {
      "enum": ["INBOUND", "OUTBOUND"]
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standardId", "version"],
      "properties": {
        "standardId": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "adapter": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "legalBasis": {
      "type": "string",
      "maxLength": 512
    },
    "dataClassification": {
      "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "SENSITIVE", "RESTRICTED"]
    },
    "fieldPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "fields"],
      "properties": {
        "mode": {"enum": ["ALLOW_LIST", "DENY_LIST"]},
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationDays", "onExpiry"],
      "properties": {
        "durationDays": {"type": "integer", "minimum": 0, "maximum": 36500},
        "onExpiry": {"enum": ["DELETE", "ANONYMIZE", "ARCHIVE_LEGAL_HOLD"]}
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openhimChannel", "authenticationProfile", "tlsRequired", "maxPayloadBytes"],
      "properties": {
        "openhimChannel": {"type": "string", "minLength": 1, "maxLength": 256},
        "authenticationProfile": {"type": "string", "minLength": 1, "maxLength": 128},
        "tlsRequired": {"const": true},
        "maxPayloadBytes": {"type": "integer", "minimum": 1}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "idempotencyRequired", "maxAttempts"],
      "properties": {
        "mode": {"enum": ["SYNCHRONOUS", "ASYNCHRONOUS"]},
        "idempotencyRequired": {"const": true},
        "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 100},
        "callbackChannel": {"type": "string", "maxLength": 256}
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validFrom"],
      "properties": {
        "validFrom": {"type": "string", "format": "date-time"},
        "validUntil": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["organizationId", "approvedBy", "approvedAt"],
        "properties": {
          "organizationId": {"$ref": "#/$defs/organizationId"},
          "approvedBy": {"type": "string", "minLength": 1, "maxLength": 256},
          "approvedAt": {"type": "string", "format": "date-time"}
        }
      }
    }
  },
  "$defs": {
    "organizationId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,63}$"
    }
  }
}
