# AI providers. Keep real values only in backend/.env or a secret manager.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Automatic distributed execution.
SPARK_ROW_THRESHOLD=10000000
SPARK_FILE_SIZE_THRESHOLD_BYTES=2147483648
IOL_MAX_INBOUND_BYTES=268435456
IOL_MAX_STREAM_BYTES=10737418240
IOL_MAX_NDJSON_LINE_BYTES=134217728
IOL_STREAM_BATCH_ROWS=500
APP_UPLOAD_MAX_FILE_SIZE=5GB
APP_UPLOAD_MAX_REQUEST_SIZE=5GB
APP_UPLOAD_MAX_FILE_SIZE_BYTES=5368709120
OBJECT_STORAGE_MULTIPART_PART_SIZE_BYTES=67108864
OBJECT_STORAGE_FAILED_RETENTION_HOURS=72
