# OpenHIM mediator registration
OPENHIM_MEDIATOR_USERNAME=root@openhim.org
OPENHIM_MEDIATOR_PASSWORD=change-me

# Must match backend/.env INTEROP_INTERNAL_SECRET
INTEROP_INTERNAL_SECRET=change-me

# Optional default routing
IOL_DEFAULT_STANDARD_ID=
IOL_DEFAULT_WORKFLOW_ID=
IOL_DEFAULT_SOURCE_SYSTEM=generic-json
IOL_DEFAULT_ADAPTER=generic-json
IOL_INBOUND_AUTH_TYPE=private
IOL_INBOUND_ALLOWED_ROLES=iol-inbound
IOL_INBOUND_CLIENT_ID=replace-with-partner-system-id
IOL_INBOUND_CLIENT_NAME=Partner system
IOL_INBOUND_CLIENT_PASSWORD=replace-with-a-long-random-secret
IOL_MEDIATOR_REGISTRATION_RETRY_MS=15000

# OUTBOUND delivery
OPENHIM_EGRESS_BASE_URL=http://openhim-core:5001
OUTBOUND_AUTH_SECRETS_JSON={"hospital-b-token":"replace-with-a-real-secret"}
