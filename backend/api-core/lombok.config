# Lombok ne recopie pas les annotations de champ vers les parametres du
# constructeur genere par @RequiredArgsConstructor. Sans cette directive,
# @Qualifier est perdu et l'injection retombe sur une correspondance par nom
# de parametre — fragile des qu'il existe plusieurs beans du meme type
# (plusieurs Executor, par exemple).
config.stopBubbling = true
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
