# Configuration non sensible de la production IOL. Les valeurs ciblees doivent
# etre renseignees avant le premier lancement. Ne jamais ajouter ici de mot de
# passe, cle, jeton, certificat ou cle privee : utiliser Docker secrets/Vault.

COMPOSE_PROJECT_NAME=iol
IOL_DEPLOYMENT_ENV=production
IOL_IMAGE_REGISTRY=ghcr.io/speedykom
IOL_RELEASE_TAG=REPLACE_WITH_IMMUTABLE_RELEASE_TAG
IOL_PUBLIC_URL=https://iol.example.org
IOL_PUBLIC_HOSTNAME=iol.example.org
IOL_DOCKER_NETWORK=iol-production-internal
IOL_EGRESS_DOCKER_NETWORK=iol-production-egress
IOL_VAULT_DOCKER_NETWORK=iol-vault-client
VAULT_ADDR=https://vault:8200
RUSTFS_VAULT_ADDR=https://vault:8202
VAULT_NAMESPACE=
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=iol-business-credentials
RUSTFS_KMS_KEY_ID=iol-rustfs

# Genere une seule fois avec : kafka-storage random-uuid
KAFKA_CLUSTER_ID=REPLACE_WITH_KAFKA_STORAGE_RANDOM_UUID
POSTGRES_USER=etl_user

SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=iol@example.org
SMTP_FROM=iol@example.org
SMTP_STARTTLS=true
SMTP_SSL=false
IOL_INITIAL_ADMIN_USERNAME=admin@iol.example.org
IOL_INITIAL_ADMIN_EMAIL=admin@iol.example.org

AUTH_COOKIE_SECURE=true
# Organisation unique : aucune option de configuration n'active le
# multi-organisation dans cette version.
DEFAULT_ORGANIZATION_ID=iol-default
PIPELINE_CONSUMER_REPLICAS=3
PIPELINE_CONSUMER_CONCURRENCY=3
SOURCE_GATEWAY_REPLICAS=3
SOURCE_GATEWAY_CONCURRENCY=2
APP_KAFKA_MAX_POLL_INTERVAL_MS=604800000
HOP_EXECUTION_TIMEOUT_SECONDS=86400
HOP_PROJECT_NAME=Test ETL
HOP_WORKFLOW_FILE=wf_main_ingestion.hwf
HOP_RUN_CONFIG_LOCAL=local
HOP_RUN_CONFIG_SPARK=spark
SPARK_EXECUTION_TIMEOUT_SECONDS=518400
SPARK_WORKER_REPLICAS=3
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=4g
KEYCLOAK_MEMORY_LIMIT=2g

SPARK_ROW_THRESHOLD=10000000
SPARK_FILE_SIZE_THRESHOLD_BYTES=2147483648
IOL_MAX_INBOUND_BYTES=268435456
IOL_MAX_STREAM_BYTES=10737418240
IOL_MAX_NDJSON_LINE_BYTES=134217728
IOL_STREAM_BATCH_ROWS=500
INTEROP_IDEMPOTENCY_LEASE_SECONDS=86400
APP_UPLOAD_MAX_FILE_SIZE=5GB
APP_UPLOAD_MAX_REQUEST_SIZE=5GB
APP_UPLOAD_MAX_FILE_SIZE_BYTES=5368709120
OBJECT_STORAGE_MULTIPART_PART_SIZE_BYTES=67108864
OBJECT_STORAGE_FAILED_RETENTION_HOURS=72

MALWARE_SCAN_ENABLED=true
MALWARE_SCAN_FAIL_CLOSED=true
MALWARE_SCAN_MAX_FILE_SIZE_BYTES=2147483648
MALWARE_QUARANTINE_RETENTION_DAYS=30
MALWARE_QUARANTINE_CLEANUP_INTERVAL_MS=3600000
CLAMAV_VERSION=1.4
CLAMAV_SIGNATURE_CHECKS_PER_DAY=12

RESTIC_REPOSITORY=s3:https://backup.example/iol-production
RESTIC_PASSWORD_FILE=/run/secrets/iol-restic-password
AWS_ACCESS_KEY_ID_FILE=/run/secrets/backup-s3-access-key
AWS_SECRET_ACCESS_KEY_FILE=/run/secrets/backup-s3-secret-key
AWS_DEFAULT_REGION=us-east-1
BACKUP_ROOT=/var/backups/iol
RESTORE_TEST_AFTER_BACKUP=true
REQUIRE_OFFSITE_BACKUP=true
